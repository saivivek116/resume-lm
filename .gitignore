# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# git worktrees
.worktrees/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.cursorrules
.aider*

.__tests__
/tests

.superpowers/

# claude code local settings (personal, not shared)
.claude/settings.local.json

# temp output from scripts/verify-tool-schemas.mjs
.schema-check-*/

# local Redis snapshots - redis-server writes dump.rdb into its cwd when
# started without a config file, which breaks startup on older Redis builds
# that cannot read newer RDB format versions
dump.rdb
*.rdb
appendonlydir/
appendonly.aof
*.aof
